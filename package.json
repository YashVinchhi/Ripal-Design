{
  "name": "ripal-design-tailwind-build",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "tailwindcss": "^3.4.2",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.19"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/styles.css --minify && node -e \"require('fs').writeFileSync('assets/build-manifest.json', JSON.stringify({css: 'styles.css?v=' + Date.now()}))\"",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/styles.css --watch"
  }
}
